# ── Core ──
DATABASE_URL="postgresql://rafik:CHANGE_ME@localhost:5432/rafik_app?schema=public"
JWT_SECRET="a-long-random-string"
PORT=4000
CORS_ORIGINS="http://5.196.32.222,http://localhost:3000"

# Public web address (used to build the password-reset link in emails)
APP_WEB_URL="http://5.196.32.222"

# ── Email (SMTP) — needed for forgot-password + email notifications ──
# If MAIL_HOST is empty, emails are logged to the console instead of sent
# (so nothing crashes before you configure a provider).
# Gmail example: host smtp.gmail.com, port 587, secure false, use an App Password.
MAIL_HOST=""
MAIL_PORT="587"
MAIL_SECURE="false"          # "true" only for port 465
MAIL_USER=""
MAIL_PASS=""
MAIL_FROM="Rafik <no-reply@rafik.app>"

# ── Cloudflare R2 (image storage) ──
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_URL=""
