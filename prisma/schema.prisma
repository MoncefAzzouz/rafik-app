generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  WORKER
  CLIENT
}

// MEDIATED = admin sits between worker and client (relays quotes/contact)
// DIRECT   = worker and client talk directly (chat enabled), admin only observes
enum MediationMode {
  MEDIATED
  DIRECT
}

// PERCENTAGE   = platform takes a % of each completed job
// SUBSCRIPTION = worker pays a fixed monthly fee, keeps 100% of job money
enum CommissionMode {
  PERCENTAGE
  SUBSCRIPTION
}

// Singleton row (id = "global") holding the platform-wide defaults.
// Per-worker overrides live on Professional and win when set.
model PlatformSettings {
  id                String         @id @default("global")
  mediationMode     MediationMode  @default(MEDIATED)
  commissionMode    CommissionMode @default(PERCENTAGE)
  commissionPercent Float          @default(15)
  subscriptionFee   Int            @default(3000)
  updatedAt         DateTime       @updatedAt
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  phone         String        @unique
  passwordHash  String
  fullName      String
  role          Role          @default(CLIENT)
  profileImage  String?
  wilaya        String?
  commune       String?
  address       String?
  createdAt     DateTime      @default(now())
  professional  Professional?
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String
  pros      Int      @default(0)
  bookings  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Professional {
  id             String    @id
  name           String
  category       String
  phone          String
  status         String    @default("offline")
  verified       Boolean   @default(false)
  jobs           Int       @default(0)
  rating         Float     @default(5.0)
  joined         String
  rate           String
  experience     String
  bio            String
  profileImage   String?
  portfolio      String[]  // legacy flat image list — new work uses PortfolioPost
  portfolioPosts PortfolioPost[]
  availableTimes String[]
  // Location (start: Sétif) — lat/lng optional, for future GPS from mobile
  wilaya         String?
  commune        String?
  address        String?
  lat            Float?
  lng            Float?
  // Per-worker overrides; null = follow the global PlatformSettings
  mediationModeOverride     MediationMode?
  commissionModeOverride    CommissionMode?
  commissionPercentOverride Float?
  subscriptionFeeOverride   Int?
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id])
  reviews        Review[]
  bookings       Booking[]
  subscriptionPayments SubscriptionPayment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Review {
  id             String       @id @default(cuid())
  clientName     String
  rating         Float
  comment        String
  date           String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String
  createdAt      DateTime     @default(now())
}

model Booking {
  id              String          @id
  clientId        String?
  clientName      String
  clientPhone     String
  clientAddress   String
  clientWilaya    String?
  clientCommune   String?
  clientLat       Float?
  clientLng       Float?
  serviceCategory String
  worker          Professional    @relation(fields: [workerId], references: [id])
  workerId        String
  status          String          @default("pending_review")
  price           String
  description     String
  time            String
  bookingDate     String
  bookingTime     String?
  clientPhotos    String[]
  workerQuote     Int?
  quoteStatus     String          @default("none")
  // Mode the booking runs under, frozen at creation
  mediationModeSnapshot MediationMode?
  // Money snapshot frozen at completion so later settings changes don't rewrite history
  finalPrice                Int?
  commissionModeSnapshot    CommissionMode?
  commissionPercentSnapshot Float?
  commissionAmount          Int?
  conversation    Conversation?
  statusHistory   StatusHistory[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model StatusHistory {
  id        String   @id @default(cuid())
  status    String
  timestamp String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
}

// One conversation per booking (created for DIRECT-mode bookings)
model Conversation {
  id        String    @id @default(cuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     Role
  text           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

// A portfolio entry published by a worker — like a small post: photo + caption
model PortfolioPost {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  image          String
  caption        String?
  createdAt      DateTime     @default(now())

  @@index([professionalId, createdAt])
}

// Admin-recorded subscription payments from SUBSCRIPTION-mode workers
model SubscriptionPayment {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  amount         Int
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime     @default(now())
  note           String?
}
