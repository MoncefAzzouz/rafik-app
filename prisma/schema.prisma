generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  WORKER
  CLIENT
  RESTAURANT
  DRIVER
  CASHIER
}

// MEDIATED = admin sits between worker and client (relays quotes/contact)
// DIRECT   = worker and client talk directly (chat enabled), admin only observes
enum MediationMode {
  MEDIATED
  DIRECT
}

// PERCENTAGE   = platform takes a % of each completed job
// SUBSCRIPTION = worker pays a fixed monthly fee, keeps 100% of job money
enum CommissionMode {
  PERCENTAGE
  SUBSCRIPTION
}

// Singleton row (id = "global") holding the platform-wide defaults.
// Per-worker overrides live on Professional and win when set.
model PlatformSettings {
  id                String         @id @default("global")
  mediationMode     MediationMode  @default(MEDIATED)
  commissionMode    CommissionMode @default(PERCENTAGE)
  commissionPercent Float          @default(15)
  subscriptionFee   Int            @default(3000)
  // Food delivery config (Tawsil-style)
  foodDeliveryFeeBase  Int   @default(200) // DZD, base delivery fee
  foodDeliveryFeePerKm Float @default(0)   // DZD per km
  // Revenue→subscription tier grid: [{minRevenue, maxRevenue|null, fee}]
  restaurantSubscriptionGrid Json?
  // Taxi config (fixed formula — the price is calculated, the client does NOT negotiate)
  taxiBaseFare          Int   @default(100) // DZD flag-fall
  taxiPerKm             Float @default(30)  // DZD per km
  taxiMinFare           Int   @default(150) // DZD floor
  taxiCommissionPercent Float @default(10)  // platform % of each completed ride
  updatedAt         DateTime       @updatedAt
}

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  phone         String        @unique
  passwordHash  String
  fullName      String
  role          Role          @default(CLIENT)
  profileImage  String?
  wilaya        String?
  commune       String?
  address       String?
  createdAt     DateTime      @default(now())
  professional  Professional?
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  image     String
  pros      Int      @default(0)
  bookings  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Professional {
  id             String    @id
  name           String
  category       String
  phone          String
  status         String    @default("offline")
  verified       Boolean   @default(false)
  jobs           Int       @default(0)
  rating         Float     @default(5.0)
  joined         String
  rate           String
  experience     String
  bio            String
  profileImage   String?
  portfolio      String[]  // legacy flat image list — new work uses PortfolioPost
  portfolioPosts PortfolioPost[]
  availableTimes String[]
  // Location (start: Sétif) — lat/lng optional, for future GPS from mobile
  wilaya         String?
  commune        String?
  address        String?
  lat            Float?
  lng            Float?
  // Per-worker overrides; null = follow the global PlatformSettings
  mediationModeOverride     MediationMode?
  commissionModeOverride    CommissionMode?
  commissionPercentOverride Float?
  subscriptionFeeOverride   Int?
  userId         String?   @unique
  user           User?     @relation(fields: [userId], references: [id])
  reviews        Review[]
  bookings       Booking[]
  subscriptionPayments SubscriptionPayment[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model Review {
  id             String       @id @default(cuid())
  clientName     String
  rating         Float
  comment        String
  date           String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String
  createdAt      DateTime     @default(now())
}

model Booking {
  id              String          @id
  clientId        String?
  clientName      String
  clientPhone     String
  clientAddress   String
  clientWilaya    String?
  clientCommune   String?
  clientLat       Float?
  clientLng       Float?
  serviceCategory String
  worker          Professional    @relation(fields: [workerId], references: [id])
  workerId        String
  status          String          @default("pending_review")
  price           String
  description     String
  time            String
  bookingDate     String
  bookingTime     String?
  clientPhotos    String[]
  workerQuote     Int?
  quoteStatus     String          @default("none")
  // Mode the booking runs under, frozen at creation
  mediationModeSnapshot MediationMode?
  // Money snapshot frozen at completion so later settings changes don't rewrite history
  finalPrice                Int?
  promoCodeId               String?
  promoDiscount             Int?            @default(0) // DZD off from a promo code
  commissionModeSnapshot    CommissionMode?
  commissionPercentSnapshot Float?
  commissionAmount          Int?
  conversation    Conversation?
  statusHistory   StatusHistory[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model StatusHistory {
  id        String   @id @default(cuid())
  status    String
  timestamp String
  booking   Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingId String
}

// One conversation per booking (created for DIRECT-mode bookings)
model Conversation {
  id        String    @id @default(cuid())
  bookingId String    @unique
  booking   Booking   @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  senderRole     Role
  text           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId, createdAt])
}

// A portfolio entry published by a worker — like a small post: photo + caption
model PortfolioPost {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  image          String
  caption        String?
  createdAt      DateTime     @default(now())

  @@index([professionalId, createdAt])
}

// ═══════════════════ FOOD DELIVERY (Tawsil-style) ═══════════════════

enum RestaurantStatus {
  PENDING
  APPROVED
  SUSPENDED
  ARCHIVED
}

enum AvailabilityStatus {
  OPEN
  CLOSED
  VACATION
  SATURATED
  OTHER
}

enum VehicleType {
  MOTORCYCLE
  BICYCLE
  SCOOTER
  CAR
}

enum DriverStatus {
  AVAILABLE
  BUSY
  OFFLINE
  SUSPENDED
}

// Which vertical a driver works for
enum ServiceKind {
  FOOD
  TAXI
  BOTH
}

enum RideCancelledBy {
  CLIENT
  DRIVER
  ADMIN
}

enum FraudAlertType {
  DRIVER_EXCESSIVE_CANCELLATIONS
  CLIENT_EXCESSIVE_CANCELLATIONS
  PAIR_COLLUSION
  LATE_CANCEL_PATTERN
}

enum FraudSeverity {
  LOW
  MEDIUM
  HIGH
}

// Which vertical(s) a promo code applies to
enum PromoScope {
  TAXI
  FOOD
  SERVICES
  ALL
}

enum PromoDiscountType {
  PERCENTAGE // percent off (with optional cap)
  FIXED      // flat DZD off
}

enum OrderType {
  DELIVERY
  PICKUP
}

enum FoodPaymentMethod {
  CASH_ON_DELIVERY
  BARIDI_MOB
  BANK_TRANSFER
}

model Restaurant {
  id                 String             @id @default(cuid())
  userId             String?            @unique
  name               String
  description        String?
  address            String?
  phone              String
  email              String?
  image              String?
  rating             Float              @default(0)
  isActive           Boolean            @default(true)
  isPremium          Boolean            @default(false)
  status             RestaurantStatus   @default(PENDING)
  availabilityStatus AvailabilityStatus @default(OPEN)
  availabilityNote   String?
  openingHours       Json?
  wilaya             String?
  commune            String?
  lat                Float?
  lng                Float?
  categories         FoodMenuCategory[]
  menuItems          MenuItem[]
  orders             FoodOrder[]
  cashiers           Cashier[]
  subscriptionPayments RestaurantSubscriptionPayment[]
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
}

model FoodMenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  image        String?
  displayOrder Int        @default(0)
  menuItems    MenuItem[]
  createdAt    DateTime   @default(now())
}

model MenuItem {
  id           String            @id @default(cuid())
  restaurantId String
  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String?
  category     FoodMenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name         String
  description  String?
  price        Int               // DZD
  image        String?
  isAvailable  Boolean           @default(true)
  prepTime     Int               @default(20) // minutes
  optionGroups OptionGroup[]
  additions    Addition[]
  orderItems   FoodOrderItem[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Add-on option groups (e.g. "Sauce" required, "Extras" optional)
model OptionGroup {
  id           String     @id @default(cuid())
  menuItemId   String
  menuItem     MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name         String
  isRequired   Boolean    @default(false)
  displayOrder Int        @default(0)
  additions    Addition[]
}

model Addition {
  id            String       @id @default(cuid())
  menuItemId    String
  menuItem      MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  optionGroupId String?
  optionGroup   OptionGroup? @relation(fields: [optionGroupId], references: [id], onDelete: SetNull)
  name          String
  price         Int          @default(0) // DZD
  isAvailable   Boolean      @default(true)
  orderItemAdditions FoodOrderItemAddition[]
}

model Driver {
  id                String       @id @default(cuid())
  userId            String?      @unique
  driverCode        String       @unique // DRV-0001
  name              String
  phone             String       @unique
  email             String?
  profileImage      String?
  vehicleType       VehicleType  @default(MOTORCYCLE)
  vehiclePlate      String?
  vehicleModel      String?      // e.g. "Hyundai i10" (taxi)
  vehicleColor      String?
  licenseNumber     String?
  service           ServiceKind  @default(FOOD)
  status            DriverStatus @default(OFFLINE)
  lat               Float?
  lng               Float?
  rating            Float        @default(0)
  totalDeliveries   Int          @default(0)
  maxOrdersCapacity Int          @default(5)
  isVerified        Boolean      @default(false)
  isActive          Boolean      @default(true)
  cancellationCount Int          @default(0)
  wilaya            String?
  commune           String?
  notes             String?
  orders            FoodOrder[]
  taxiRides         TaxiRide[]
  rideOffers        TaxiRideOffer[]
  fraudAlerts       FraudAlert[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

// ─── TAXI (inDrive-style negotiation + Yassir-style dispatch) ───

model TaxiRide {
  id            String   @id @default(cuid())
  rideNumber    String   @unique // TX-YYYYMMDD-0001
  clientId      String?  // User.id when requested from the app
  clientName    String
  clientPhone   String
  // Pickup / destination
  pickupAddress      String
  pickupWilaya       String?
  pickupCommune      String?
  pickupLat          Float?
  pickupLng          Float?
  destinationAddress String
  destinationLat     Float?
  destinationLng     Float?
  distanceKm         Float?
  // Money (fixed formula — no negotiation): app calculates, admin sets the formula
  estimatedFare Int?   // computed: max(minFare, base + km*perKm)
  proposedFare  Int?   // deprecated (client negotiation removed) — kept for old rows
  promoCodeId   String?
  promoDiscount Int?   @default(0) // DZD off from a promo code
  agreedFare    Int?   // final price the client pays (estimate − promo)
  // requested → accepted → driver_arrived → in_ride → completed
  // cancelled_by_client / cancelled_by_driver / cancelled_by_admin / expired terminal
  status        String  @default("requested")
  driverId      String?
  driver        Driver? @relation(fields: [driverId], references: [id])
  offers        TaxiRideOffer[]
  // Commission snapshot frozen at completion
  commissionPercentSnapshot Float?
  commissionAmount          Int?
  driverEarnings            Int?
  // Cancellation forensics (feeds the fraud detector)
  cancelledBy   RideCancelledBy?
  cancelReason  String?
  cancelStage   String? // status the ride was in when cancelled
  // Ratings
  clientRating  Float?
  driverRating  Float?
  // Timers
  acceptedAt    DateTime?
  arrivedAt     DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  cancelledAt   DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([driverId, status])
  @@index([clientPhone])
}

// A driver's price offer on a ride (inDrive negotiation)
model TaxiRideOffer {
  id        String   @id @default(cuid())
  rideId    String
  ride      TaxiRide @relation(fields: [rideId], references: [id], onDelete: Cascade)
  driverId  String
  driver    Driver   @relation(fields: [driverId], references: [id], onDelete: Cascade)
  amount    Int      // DZD
  status    String   @default("pending") // pending | accepted | rejected | withdrawn
  createdAt DateTime @default(now())

  @@unique([rideId, driverId])
}

// Anti-scam alerts raised by the fraud detection engine
model FraudAlert {
  id          String         @id @default(cuid())
  type        FraudAlertType
  severity    FraudSeverity  @default(MEDIUM)
  driverId    String?
  driver      Driver?        @relation(fields: [driverId], references: [id], onDelete: Cascade)
  clientPhone String?
  clientName  String?
  rideId      String?
  message     String
  details     Json?          // counters/evidence snapshot
  isResolved  Boolean        @default(false)
  resolvedBy  String?        // admin User.id
  resolvedAt  DateTime?
  action      String?        // suspended | warned | dismissed | auto_suspended
  createdAt   DateTime       @default(now())

  @@index([driverId, isResolved])
  @@index([clientPhone, isResolved])
}

model Cashier {
  id           String     @id @default(cuid())
  userId       String?    @unique
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  cashierCode  String     @unique // CSH-0001
  name         String
  phone        String?
  email        String?
  isActive     Boolean    @default(true)
  ordersCreated FoodOrder[]
  createdAt    DateTime   @default(now())
}

model FoodOrder {
  id                   String             @id @default(cuid())
  orderNumber          String             @unique // DEL-YYYYMMDD-0001 / PKP-...
  clientId             String?            // User.id when ordered from the app
  createdByCashierId   String?
  createdByCashier     Cashier?           @relation(fields: [createdByCashierId], references: [id])
  restaurantId         String
  restaurant           Restaurant         @relation(fields: [restaurantId], references: [id])
  driverId             String?
  driver               Driver?            @relation(fields: [driverId], references: [id])
  orderType            OrderType          @default(DELIVERY)
  clientName           String
  clientPhone          String
  deliveryAddress      String?
  deliveryWilaya       String?
  deliveryCommune      String?
  deliveryLat          Float?
  deliveryLng          Float?
  deliveryInstructions String?
  // pending → accepted → preparing → assigned → arrived → delivering → delivered | declined | cancelled
  status               String             @default("pending")
  paymentMethod        FoodPaymentMethod  @default(CASH_ON_DELIVERY)
  subtotal             Int                @default(0)
  deliveryFee          Int                @default(0)
  deliveryDistance     Float?             // km
  promoCodeId          String?
  promoDiscount        Int                @default(0) // DZD off from a promo code
  totalAmount          Int                @default(0) // subtotal + deliveryFee − promoDiscount
  prepTime             Int?               // minutes, set on accept
  declineReason        String?
  // stage timestamps
  acceptedAt           DateTime?
  preparingAt          DateTime?
  assignedAt           DateTime?
  arrivedAt            DateTime?
  deliveringAt         DateTime?
  deliveredAt          DateTime?
  // ratings after delivery
  restaurantRating     Float?
  driverRating         Float?
  restaurantComment    String?
  driverComment        String?
  items                FoodOrderItem[]
  statusHistory        FoodOrderStatusHistory[]
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

model FoodOrderItem {
  id                  String     @id @default(cuid())
  orderId             String
  order               FoodOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId          String
  menuItem            MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Restrict)
  quantity            Int        @default(1)
  unitPrice           Int
  totalPrice          Int
  specialInstructions String?
  additions           FoodOrderItemAddition[]
}

model FoodOrderItemAddition {
  id          String        @id @default(cuid())
  orderItemId String
  orderItem   FoodOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  additionId  String
  addition    Addition      @relation(fields: [additionId], references: [id], onDelete: Restrict)
  quantity    Int           @default(1)
  unitPrice   Int
  totalPrice  Int
}

model FoodOrderStatusHistory {
  id        String    @id @default(cuid())
  orderId   String
  order     FoodOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  timestamp DateTime  @default(now())
}

// Monthly restaurant subscription (Tawsil-style revenue tiers instead of per-order commission)
model RestaurantSubscriptionPayment {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  monthKey      String     // YYYY-MM
  revenueAmount Int        @default(0)
  ordersCount   Int        @default(0)
  tierLevel     Int        @default(1)
  totalDue      Int        @default(0)
  paidAmount    Int        @default(0)
  status        String     @default("unpaid") // unpaid | partial | paid
  paidAt        DateTime?
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([restaurantId, monthKey])
}

// Admin-recorded subscription payments from SUBSCRIPTION-mode workers
model SubscriptionPayment {
  id             String       @id @default(cuid())
  professionalId String
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  amount         Int
  periodStart    DateTime
  periodEnd      DateTime
  paidAt         DateTime     @default(now())
  note           String?
}

// ─── PROMO CODES (shared by taxi, food, and services) ───
model PromoCode {
  id             String            @id @default(cuid())
  code           String            @unique // stored UPPERCASE, e.g. WELCOME20
  description    String?
  scope          PromoScope        @default(ALL)
  discountType   PromoDiscountType @default(PERCENTAGE)
  discountValue  Float             // 20 (=20%) or 500 (=500 DZD)
  maxDiscount    Int?              // cap for percentage discounts (DZD); null = no cap
  minOrderAmount Int?              // minimum order/fare to qualify (DZD)
  maxUses        Int?              // total redemptions allowed; null = unlimited
  maxUsesPerUser Int               @default(1)
  usedCount      Int               @default(0)
  startsAt       DateTime?         // becomes usable from this date
  expiresAt      DateTime?         // deadline; after this the code is dead
  isActive       Boolean           @default(true)
  redemptions    PromoRedemption[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}

// One row per successful use — powers maxUses and per-user limits
model PromoRedemption {
  id          String     @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode  @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String?    // User.id when logged in
  clientPhone String?    // fallback identity for phone bookings
  scope       PromoScope
  refType     String     // "taxi" | "food" | "booking"
  refId       String     // the ride/order/booking id
  discount    Int        // DZD actually applied
  createdAt   DateTime   @default(now())

  @@index([promoCodeId, userId])
  @@index([promoCodeId, clientPhone])
}
